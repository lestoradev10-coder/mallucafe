<section class="banner banner-two py-120 bg-img">
    <div class="banner-two__bg">
        <img src="assets/images/thumb/banner-bid.png" alt="">
    </div>
    <div class="container">
        <div class="row gy-5 align-items-center">
            <div class="col-lg-7">
