    .preloader1{
  position: fixed;
  z-index: 999999;
  background-color:#fff;
  width: 100%;
  height: 100%;
}
.loader-p1{
  border: 0 solid transparent;
  border-radius: 50%;
  width: 150px;
  height: 150px;
  position: absolute;
  top: calc(50vh - 75px);
  left: calc(50vw - 75px);
}
.loader-p1:before, .loader-p1:after{
  content: '';
  background-image: url('assets/images/logo/logos.png'); 
  background-size: contain; 
  background-repeat: no-repeat;
  width: inherit;
  height: inherit;
  position: absolute;
  top: 0;
  left: 0;
  animation: loader 2s linear infinite;
  opacity: 0;
}

.loader-p1:before{
  animation-delay: 0.5s;
}


@keyframes loader{
  0%{
    transform: scale(0);
    opacity: 0;
  }
  50%{
    opacity: 1;
  }
  100%{
    transform: scale(1);
    opacity: 0;
  }
 }
 /* Saturday Special Banner */
/* Saturday Special Banner */
/* General Styling */
.live-youtube-wrapper {
    padding-top: 60px;
    padding-bottom: 120px;
}

/* Left Side Image Styling */
.live-show-image {
    width: 100%;
    height: auto;
    border-radius: 8px;
    position: relative;
}

/* Countdown Overlay Styling */
.countdown-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: white;
    text-align: center;
    border-radius: 8px;
}

.countdown-text {
    font-size: 1.5rem;
    font-weight: bold;
}

.countdown-timer {
    font-size: 2rem;
    font-weight: bold;
    margin-top: 10px;
}

/* Right Side Styling */
.saturday-special {
    text-align: center;
    background-color: #f26a27;
    color: #333;
    padding: 20px;
    border-radius: 8px;
}

.saturday-special h2 {
    font-size: 2rem;
    font-weight: bold;
}

.saturday-special .event-time {
    font-size: 1.2rem;
    font-weight: 600;
}

/* Play Button Styling */
.play-btn {
    background-color: #ff5733;
    color: #fff;
    padding: 10px 20px;
    font-size: 1.1rem;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

.play-btn:hover {
    background-color: #e14a2b;
}



.tab-list {
            padding: 120px 0;
            background-size: cover;
            color: #fff;
        }
        .tab-list-wrapper {
            text-align: center;
            margin-bottom: 30px;
        }
        .saturday-heading {
            font-size: 2.5rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 40px;
        }
        .tab-card {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            padding: 20px;
            color: #fff;
            transition: background 0.3s ease;
        }
        .tab-card:hover {
            background: rgba(255, 255, 255, 0.2);
        }
        .tab-card__title {
            font-size: 1.5rem;
            font-weight: 600;
        }
        .tab-card__title-link {
            color: #fff;
            text-decoration: none;
        }
        .tab-card__time {
            display: flex;
            align-items: center;
            font-size: 1rem;
            margin-top: 10px;
            color: #ccc;
        }
        .tab-card__icon {
            margin-right: 8px;
            font-size: 1.2rem;
        }
        .rj-img-list {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }
        .rj-img-list__item {
            width: 60px;
            height: 60px;
            overflow: hidden;
            border-radius: 50%;
        }
        .rj-img-list__item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }


/* Country Time Section Styling */
#countdowns {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

#countdowns p {
    font-size: 1.2rem;
    color: #fff;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 5px;
    border-radius: 5px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

#countdowns p span {
    font-weight: bold;
    color: #f26a27;
}



/* Responsive Adjustments */
@media (max-width: 768px) {
    #countdowns p {
        font-size: 1rem;
        padding: 8px;
    }
}


.saturday-program {
    padding: 30px 0;
    background-color: #f4f4f4;
}

.saturday-heading {
    text-align: center;
    font-size: 2.5rem;
    font-weight: bold;
    color: #f15a22;
    margin-bottom: 40px;
}

.program-card {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
}

.program-card-item {
    background-color: #229242; /* Green background */
    box-shadow: 6px 8px 10px rgba(238, 111, 6, 0.9); /* Orange shadow */
    border-radius: 8px;
    color: white;
    text-align: center;
    position: relative;
    overflow: hidden;
    width: 400px;
}

.program-image {
    width: 100%;
    height: 250px;
    object-fit: cover;
    opacity: 0.7;
}

.countdown-overlay {
    position: absolute;
    top: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 1.5rem;
    font-weight: bold;
    z-index: 1;
}

.program-details {
    padding: 20px;
    z-index: 2;
}

.program-time {
    font-size: 1.2rem;
    color: #f15a22;
    font-weight: bold;
}

.next-date {
    font-size: 1rem;
    color: #f8f5f5;
}

/* Responsive adjustments */
@media (max-width: 992px) {
    .program-card-item {
        width: calc(50% - 20px); /* Two cards per row */
    }
}

@media (max-width: 768px) {
    .program-card-item {
        width: 100%; /* One card per row */
    }

    .program-image {
        height: 200px; /* Adjust image height for smaller screens */
    }
}
    /* Additional Styles */
