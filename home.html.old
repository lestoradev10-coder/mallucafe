/* Testimonials Section */
.testimonials {
    padding: 80px 0;
    background-size: cover;
    background-position: center;
    color: #333;
}

.testimonials h2 {
    font-size: 2.5rem;
    color:#229242;
    text-shadow: 2px 2px 6px rgba(34, 139, 34, 0.3), 0px 2px 4px rgba(255, 165, 0, 0.4); /* Green and orange shadow effect */
    margin-bottom: 50px;
}

.testimonial-item {
    background: rgba(255, 255, 255, 0.8); /* Light background for each testimonial */
    border-radius: 10px;
    padding: 25px;
    box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.1); /* Soft shadow for 3D effect */
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.testimonial-item:hover {
    transform: translateY(-5px);
    box-shadow: 0px 6px 20px rgba(0, 0, 0, 0.2); /* Enhanced shadow on hover */
}

.testimonial-item img {
    border: 3px solid #229242; /* Border for profile image matching theme */
    box-shadow: 0 4px 10px rgba(0, 128, 0, 0.2);
}

.testimonial-name {
