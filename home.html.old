<script>
function getNextSaturday() {
    const today = new Date();
    const nextSaturday = new Date(today);

    // Calculate days until next Saturday
    let daysUntilSaturday = (6 - today.getDay() + 7) % 7;
    if (daysUntilSaturday === 0) {
        daysUntilSaturday += 7; // If today is Saturday, set it to next Saturday
    }
    
    // Set next Saturday's date
    nextSaturday.setDate(today.getDate() + daysUntilSaturday);
    
    // Format the date to 'Month Day, Year'
    const options = { month: 'long', day: 'numeric', year: 'numeric' };
    return nextSaturday.toLocaleDateString('en-US', options);
}

function setNextSaturdayDate() {
    const nextSaturday = getNextSaturday();
    
    // Set the date in each program card
    // Using only a single message with "Next Saturday: "
    const dateText = `Next Saturday: ${nextSaturday}`;
    document.getElementById('date-usa').textContent = dateText;
    document.getElementById('date-uk').textContent = dateText;
    document.getElementById('date-uae').textContent = dateText;
    document.getElementById('date-india').textContent = dateText;
}

function getNextSaturdayCountdown() {
    const today = new Date();
    let dayOfWeek = today.getDay();
    let daysUntilSaturday = 6 - dayOfWeek;
    if (daysUntilSaturday <= 0) {
        daysUntilSaturday += 7; // If today is Saturday, go to the next Saturday
    }

    // Define show times for each region in hours
    const timeZones = [
        { id: 'countdown-usa', offset: -6, hour: 7 },  // 7 AM CST (USA)
        { id: 'countdown-uk', offset: 0, hour: 12 },   // 12 PM (UK)
        { id: 'countdown-uae', offset: 4, hour: 16 },  // 4 PM (UAE)
        { id: 'countdown-india', offset: 5.5, hour: 17 } // 5:30 PM (India)
    ];

    // Set the next Saturday's date in the program cards
    setNextSaturdayDate();

    // Countdown for each time zone
    const interval = setInterval(() => {
        timeZones.forEach(zone => {
            const now = new Date();
            const nextSaturday = new Date(
                now.getFullYear(),
                now.getMonth(),
                now.getDate() + daysUntilSaturday,
                zone.hour
            );

            // Adjust the nextSaturday to the local time in each time zone
            nextSaturday.setHours(nextSaturday.getHours() + zone.offset);

            const timeRemaining = nextSaturday - now;

            const countdownElement = document.getElementById(zone.id);

            // Display the countdown or "Live Now!" if the show has started
            if (timeRemaining <= 0) {
                countdownElement.innerText = "Live Now!";
            } else {
                const days = Math.floor(timeRemaining / (1000 * 60 * 60 * 24));
                const hours = Math.floor((timeRemaining / (1000 * 60 * 60)) % 24);
                const minutes = Math.floor((timeRemaining / (1000 * 60)) % 60);
                const seconds = Math.floor((timeRemaining / 1000) % 60);
                countdownElement.innerText = `${days}d ${hours}h ${minutes}m ${seconds}s`;
            }
        });
    }, 1000);
}

// Initialize countdown timer on DOMContentLoaded
document.addEventListener('DOMContentLoaded', () => {
    setNextSaturdayDate();
    getNextSaturdayCountdown();
});

function startCountdown() {
    const programCards = document.querySelectorAll('.program-card-item');

    programCards.forEach(card => {
        const countdownText = card.querySelector('.countdown-text');
        const time = card.getAttribute('data-time');
        const daysUntil = parseInt(card.getAttribute('data-days'), 10);

        function getNextTargetDate() {
            const targetDate = new Date();
            const dayDifference = (7 - targetDate.getDay() + daysUntil) % 7;
            targetDate.setDate(targetDate.getDate() + dayDifference);
            targetDate.setHours(parseInt(time.split(':')[0]), parseInt(time.split(':')[1]), 0, 0);
            return targetDate;
        }

        let targetDate = getNextTargetDate();

        function updateCountdown() {
            const now = new Date();
            const distance = targetDate - now;

            if (distance > 0) {
                const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);
                countdownText.innerHTML = `${days}d ${hours}h ${minutes}m ${seconds}s`;
            } else {
                countdownText.innerHTML = "Show is live now!";
                if (now.getDay() === 6 && now.getHours() === 0 && now.getMinutes() === 0) {
                    // Reset the countdown for the next week
                    targetDate = getNextTargetDate();
                }
            }
        }

        updateCountdown();
        setInterval(updateCountdown, 1000);
    });
}

document.addEventListener('DOMContentLoaded', startCountdown);


    // Countdown Timer JavaScript
    const countdownElement = document.getElementById('countdown');
    const targetTime = new Date().getTime() + (2 * 60 * 60 * 1000); // 2 hours from now

    const updateCountdown = () => {
        const now = new Date().getTime();
        const distance = targetTime - now;

        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        countdownElement.innerHTML = `${hours}:${minutes}:${seconds}`;

        if (distance < 0) {
            clearInterval(timer);
            countdownElement.innerHTML = "Show Started!";
        }
    };

    const timer = setInterval(updateCountdown, 1000);

</script>
